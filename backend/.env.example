# ATS Emulator V2 - Environment Variables Template
# Copy this to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# AI API Keys (choose one or both)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.0
OPENAI_API_KEY=your_openai_api_key
# gpt-4o-mini: rewrites, skills, summary (fast, cheap, good enough)
# gpt-4o:      deep analysis (stronger reasoning, follows complex schemas)
OPENAI_MODEL=gpt-4o-mini
OPENAI_BRUTAL_MODEL=gpt-4o
OPENAI_ANALYZE_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT_SECONDS=45
OPENAI_BRUTAL_TIMEOUT_SECONDS=45
OPENAI_BRUTAL_MAX_TOKENS=2000
ANALYZE_AI_TIMEOUT_SECONDS=120
ANALYZE_AI_MODEL_TIMEOUT_SECONDS=110
REWRITE_BRUTAL_TIMEOUT_SECONDS=60
REWRITE_BRUTAL_FALLBACK_TIMEOUT_SECONDS=15

# GitHub — REST API token (5000 req/hr vs 60 unauthenticated)
GITHUB_TOKEN=your_github_personal_access_token

# Firecrawl — used to scrape GitHub profile page for pinned repos + bio
# Get yours at https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Optional: Analytics
SENTRY_DSN=
