# ATS Emulator V2 - Environment Variables Template
# Copy this to .env and fill in your values

# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key

# AI API Keys (choose one or both)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.0
OPENAI_API_KEY=your_openai_api_key
# Fast production defaults for sub-40s end-to-end responses.
# Use mini models for latency; increase only if quality is insufficient.
OPENAI_MODEL=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_BRUTAL_MODEL=gpt-4o-mini
OPENAI_ANALYZE_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT_SECONDS=20
OPENAI_BRUTAL_TIMEOUT_SECONDS=20
OPENAI_BRUTAL_MAX_TOKENS=1200
ANALYZE_TOTAL_BUDGET_SECONDS=38
ANALYZE_AI_TIMEOUT_SECONDS=22
ANALYZE_AI_WAIT_BUDGET_SECONDS=20
ANALYZE_AI_MODEL_TIMEOUT_SECONDS=16
ANALYZE_GITHUB_TIMEOUT_SECONDS=12
ANALYZE_FIRECRAWL_GITHUB_TIMEOUT_SECONDS=8
ANALYZE_GITHUB_MAX_REPOS=12
REWRITE_BRUTAL_TIMEOUT_SECONDS=28
REWRITE_BRUTAL_FALLBACK_TIMEOUT_SECONDS=8

# Match & Fix hub (OpenAI) — defaults favor latency (gpt-5-mini, ~1800 completion cap, compact list sizes).
# OPENAI_MATCHFIX_COMPACT=1 (default) appends strict caps so the model returns a smaller JSON payload faster.
# Set OPENAI_MATCHFIX_ENRICH_RETRY=1 to run a quality pass with OPENAI_MATCHFIX_SMART_MODEL (e.g. gpt-5.2).
# OPENAI_MATCHFIX_REASONING_EFFORT=none reduces reasoning time on GPT-5.2-class models when you point MATCHFIX at them.
# OPENAI_MATCHFIX_FAST_MODEL=gpt-5-mini
# OPENAI_MATCHFIX_SMART_MODEL=gpt-5.2
# OPENAI_MATCHFIX_MAX_TOKENS=1800
# OPENAI_MATCHFIX_RESUME_CHARS=5200
# OPENAI_MATCHFIX_JD_CHARS=3800
# OPENAI_MATCHFIX_TIMEOUT_SECONDS=85
# OPENAI_MATCHFIX_ENRICH_RETRY=0
# OPENAI_MATCHFIX_REASONING_EFFORT=none
# Sharded pipeline (optional): 2 parallel digests + synthesis — set OPENAI_MATCHFIX_USE_SHARDED=1 (default off).
# OPENAI_MATCHFIX_USE_SHARDED=1
# OPENAI_MATCHFIX_DIGEST_MODEL=gpt-5-mini
# OPENAI_MATCHFIX_DIGEST_MAX_TOKENS=550
# OPENAI_MATCHFIX_DIGEST_TIMEOUT_SECONDS=45
# OPENAI_MATCHFIX_DIGEST_RESUME_CHARS=4500
# OPENAI_MATCHFIX_DIGEST_JD_CHARS=3500
# OPENAI_MATCHFIX_SYNTH_RESUME_CHARS=3800
# OPENAI_MATCHFIX_SYNTH_JD_CHARS=3000
# OPENAI_MATCHFIX_DIGEST_JSON_CAP=10000
# Reddit snippets for Match & Fix `company_insights` (public search only; weak third-party signal).
# OPENAI_MATCHFIX_REDDIT=1
# OPENAI_MATCHFIX_REDDIT_TIMEOUT=12
# OPENAI_MATCHFIX_REDDIT_POST_LIMIT=10
# OPENAI_MATCHFIX_REDDIT_SNIPPET_CHARS=4500
# REDDIT_USER_AGENT=YourApp/1.0 (contact URL)

# Job description URL fetch (when the JD field is a single https://… line). Prefer FIRECRAWL for ATS pages.
# JD_URL_FETCH_TIMEOUT=28
# JD_URL_MAX_CHARS=120000
# JD_URL_FETCH_USER_AGENT=YourApp/1.0 (contact URL)

# GitHub — REST API token (5000 req/hr vs 60 unauthenticated)
GITHUB_TOKEN=your_github_personal_access_token

# Firecrawl — used to scrape GitHub profile page for pinned repos + bio
# Get yours at https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key

# Optional: Analytics
SENTRY_DSN=
